{
  "name": "risk-sense-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RiskSense AI \u2014 Express + TypeScript + Mongoose API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "openapi": "tsx src/scripts/openapi.ts",
    "audit:verify": "tsx src/scripts/verify-audit.ts",
    "templates": "tsx src/scripts/build-templates.ts",
    "seed:content": "tsx src/scripts/seed-content.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "nanoid": "^3.3.8",
    "nodemailer": "^10.0.9",
    "openai": "^4.80.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
