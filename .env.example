# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/risksense_dev

# Firebase Admin (verify ID tokens). Base64 of the service-account JSON:  base64 -i sa.json | tr -d '\n'
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Development-only: allow "X-Dev-User: <email>" header instead of a Firebase token (users must exist via `npm run seed`).
# Must be false in production (env validation enforces it).
AUTH_DEV_BYPASS=true

# Explicit kill switch for server-issued public-demo sandbox sessions. No Firebase password is public.
# This never enables X-Dev-User, email-suffix shortcuts, or production OTP disclosure. Sandbox-created
# users are confined to @demo.invalid; demo SSO is confined to .invalid and excluded from lookup/JIT.
PUBLIC_DEMO_ACCESS_ENABLED=false
# Exact Mongo ObjectId of the reviewed synthetic `tac` tenant. Required before enabling public demo
# access or running the role provisioner; never guess or derive it from a tenant name alone.
PUBLIC_DEMO_TENANT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=8000
# auto = OpenAI when a key is set; mock = deterministic heuristics (no API calls)
AI_PROVIDER=auto

# Second factor emails (T-016). console = log the code (dev only; API also returns devCode). resend|smtp in production.
# Production MAIL_FROM must be an approved sender; onboarding@resend.dev is a non-production sandbox identity and is rejected by default.
# Emergency demo-only deployments may set ALLOW_RESEND_SANDBOX_STARTUP=true to let non-mail routes
# start, but production OTP delivery remains blocked and aggregate health reports 503 degraded.
OTP_TTL_MIN=10
MAIL_PROVIDER=console
MAIL_FROM=RiskSense AI <no-reply@risksense.local>
RESEND_API_KEY=
SMTP_URL=
ALLOW_RESEND_SANDBOX_STARTUP=false

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Vercel Cron calls GET /api/v1/jobs/nightly with this value as a Bearer token. Production
# startup requires at least 16 characters; use an independently generated deployment secret.
CRON_SECRET=development-cron-secret-change-me

# Long-lived-host fallback only. Keep JOBS_ENABLED=false on Vercel, where vercel.json owns the
# 02:00 UTC trigger. RATE_LIMIT_DISABLED is accepted only for explicit non-production load tests.
JOBS_ENABLED=false
JOBS_RETENTION_HOUR=2
RATE_LIMIT_DISABLED=false
