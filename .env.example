# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/risksense_dev

# Firebase Admin (verify ID tokens). Base64 of the service-account JSON:  base64 -i sa.json | tr -d '\n'
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Development-only: allow "X-Dev-User: <email>" header instead of a Firebase token (users must exist via `npm run seed`).
# Must be false in production (env validation enforces it).
AUTH_DEV_BYPASS=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=8000
# auto = OpenAI when a key is set; mock = deterministic heuristics (no API calls)
AI_PROVIDER=auto

# Second factor emails (T-016). console = log the code (dev only; API also returns devCode). resend|smtp in production.
OTP_TTL_MIN=10
MAIL_PROVIDER=console
MAIL_FROM=RiskSense AI <no-reply@risksense.local>
RESEND_API_KEY=
SMTP_URL=

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
