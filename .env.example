# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/risksense_dev

# Firebase Admin (verify ID tokens). Base64 of the service-account JSON:  base64 -i sa.json | tr -d '\n'
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=

# Development-only: allow "X-Dev-User: <email>" header instead of a Firebase token (users must exist via `npm run seed`).
# Must be false in production (env validation enforces it).
AUTH_DEV_BYPASS=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=8000
# auto = OpenAI when a key is set; mock = deterministic heuristics (no API calls)
AI_PROVIDER=auto

# Second factor emails (T-016). console = log the code (dev only; API also returns devCode). resend|smtp in production.
# Production MAIL_FROM must be an approved sender; onboarding@resend.dev is a non-production sandbox identity and is rejected.
OTP_TTL_MIN=10
MAIL_PROVIDER=console
MAIL_FROM=RiskSense AI <no-reply@risksense.local>
RESEND_API_KEY=
SMTP_URL=

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Vercel Cron calls GET /api/v1/jobs/nightly with this value as a Bearer token. Production
# startup requires at least 16 characters; use an independently generated deployment secret.
CRON_SECRET=development-cron-secret-change-me

# Long-lived-host fallback only. Keep JOBS_ENABLED=false on Vercel, where vercel.json owns the
# 02:00 UTC trigger. RATE_LIMIT_DISABLED is accepted only for explicit non-production load tests.
JOBS_ENABLED=false
JOBS_RETENTION_HOUR=2
RATE_LIMIT_DISABLED=false

# Password for the fixed requestor@dev.local Firebase account (`npm run demo:provision-requestor`)
# and the optional meaningful-data seed. There is no default and the value must never be committed.
# Use at least 8 characters and a throwaway value: this is a public demo login, never a real
# user's credential.
DEMO_USER_PASSWORD=
